{
  "expo": {
    "name": "Lyra Web",
    "slug": "lyra-web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lyraweb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lyra.music.web"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12140F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.lyra.music.web"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Lyra",
      "shortName": "Lyra",
      "description": "Musica a tutto schermo",
      "themeColor": "#070806",
      "backgroundColor": "#070806",
      "display": "standalone",
      "startUrl": "/",
      "lang": "it",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070806"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lyra usa le tue foto per copertine e sfondi delle playlist."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
